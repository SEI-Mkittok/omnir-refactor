# Omnir CRM — Environment Config
# Copy this file to .env (root level for Docker Compose)
# Never commit .env files with real secrets.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=omnir
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=omnir_crm

# ─── API (Go) ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://omnir:change_me_in_prod@postgres:5432/omnir_crm?sslmode=disable
JWT_SECRET=change_me_to_a_random_32_char_secret_in_prod
SERVER_PORT=8080
ENV=development
# LOG_LEVEL=info | debug | warn | error
LOG_LEVEL=debug
# CORS_ORIGINS=http://localhost:5173,https://app.omnir.io
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# In dev, Vite proxies /api to the API container
VITE_API_URL=http://localhost:8080/api/v1

# ─── S3 / MinIO (Object Storage) ───────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=omnir-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
