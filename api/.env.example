# API service env — used locally (outside Docker) and in CI
# Copy to .env for local go run

DATABASE_URL=postgres://omnir:omnir_dev@localhost:5432/omnir_crm?sslmode=disable
JWT_SECRET=dev-jwt-secret-change-in-prod
SERVER_PORT=8080
ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# Multi-tenancy mode.
# single      — default; one org per deployment, no RLS enforcement.
# multitenant — SaaS; org_id required in JWT, database RLS FORCE enabled at startup.
# enterprise  — same as multitenant with stricter isolation guarantees.
ORG_MODE=single

# Global Omnir product-help wiki sync. This is separate from tenant KB content.
PRODUCT_HELP_WIKI_ENABLED=false
PRODUCT_HELP_WIKI_RAW_BASE_URL=https://raw.githubusercontent.com/wiki/SEI-Mkittok/omnir-refactor
PRODUCT_HELP_WIKI_BASE_URL=https://github.com/SEI-Mkittok/omnir-refactor/wiki
PRODUCT_HELP_WIKI_MANIFEST_PATH=omnir-product-help-manifest.json
PRODUCT_HELP_WIKI_SYNC_INTERVAL=1h
